{
  "name": "x402-spotcheck",
  "version": "1.5.1",
  "description": "Check before you pay, for x402 clients and routers. Local rules by default (no network calls, no tracking); the 402xAgent service is opt-in. Unknown means pay; skip only with a reason code.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./rules": {
      "types": "./rules.d.ts",
      "default": "./rules.js"
    },
    "./testkit": {
      "types": "./testkit.d.ts",
      "default": "./testkit.js"
    },
    "./receipt": {
      "types": "./receipt.d.ts",
      "default": "./receipt.js"
    },
    "./after": {
      "types": "./after.d.ts",
      "default": "./after.js"
    },
    "./audit": {
      "types": "./audit.d.ts",
      "default": "./audit.js"
    },
    "./audit/sqlite": {
      "types": "./audit-sqlite.d.ts",
      "default": "./audit-sqlite.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "receipt.js",
    "receipt.d.ts",
    "after.js",
    "after.d.ts",
    "audit.js",
    "audit.d.ts",
    "expiry.js",
    "CHANGELOG.md",
    "rules.js",
    "rules.d.ts",
    "testkit.js",
    "testkit.d.ts",
    "README.md",
    "LICENSE",
    "examples",
    "audit-sqlite.js",
    "audit-sqlite.d.ts"
  ],
  "scripts": {
    "test": "node test/test.mjs && node test/autopay.mjs && node --test test/v1.test.mjs && node --test test/receipt.test.mjs && node --test test/after.test.mjs && node --test test/hosted.test.mjs && node --test test/test-kit.test.mjs && node --test test/expiry.test.mjs && node --test test/audit.test.mjs && node --test test/version-header.test.mjs && node --test test/audit-sqlite.test.mjs",
    "test:integration": "node test/integration.mjs"
  },
  "keywords": [
    "402xagent",
    "agents",
    "base",
    "guard",
    "mcp",
    "onBeforePaymentCreation",
    "payments",
    "pre-payment-check",
    "router",
    "solana",
    "usdc",
    "x402"
  ],
  "author": "withgrokbot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withgrokbot/x402-spotcheck.git"
  },
  "homepage": "https://github.com/withgrokbot/x402-spotcheck#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@x402/axios": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "axios": "^1.7.0",
    "viem": "^2.21.0"
  }
}
