{
  "name": "x402-spotcheck",
  "version": "1.6.1",
  "description": "Check before you pay, for x402 clients and routers. Local rules by default (no network calls, no tracking); the 402xAgent service is opt-in. Unknown means pay; skip only with a reason code.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./rules": {
      "types": "./rules.d.ts",
      "default": "./rules.js"
    },
    "./testkit": {
      "types": "./testkit.d.ts",
      "default": "./testkit.js"
    },
    "./receipt": {
      "types": "./receipt.d.ts",
      "default": "./receipt.js"
    },
    "./after": {
      "types": "./after.d.ts",
      "default": "./after.js"
    },
    "./audit": {
      "types": "./audit.d.ts",
      "default": "./audit.js"
    },
    "./audit/sqlite": {
      "types": "./audit-sqlite.d.ts",
      "default": "./audit-sqlite.js"
    },
    "./networks": {
      "types": "./networks.d.ts",
      "default": "./networks.js"
    },
    "./audit/remote": {
      "types": "./audit-remote.d.ts",
      "default": "./audit-remote.js"
    },
    "./audit/server": {
      "types": "./audit-server.d.ts",
      "default": "./audit-server.js"
    },
    "./audit/evm-verify": {
      "types": "./evm-verify.d.ts",
      "default": "./evm-verify.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "receipt.js",
    "receipt.d.ts",
    "after.js",
    "after.d.ts",
    "audit.js",
    "audit.d.ts",
    "expiry.js",
    "CHANGELOG.md",
    "rules.js",
    "rules.d.ts",
    "testkit.js",
    "testkit.d.ts",
    "README.md",
    "LICENSE",
    "examples",
    "audit-sqlite.js",
    "audit-sqlite.d.ts",
    "networks.js",
    "networks.d.ts",
    "audit-remote.js",
    "audit-remote.d.ts",
    "audit-server.js",
    "audit-server.d.ts",
    "evm-verify.js",
    "evm-verify.d.ts",
    "docs/"
  ],
  "scripts": {
    "test": "node test/test.mjs && node test/autopay.mjs && node --test test/v1.test.mjs && node --test test/receipt.test.mjs && node --test test/after.test.mjs && node --test test/hosted.test.mjs && node --test test/test-kit.test.mjs && node --test test/expiry.test.mjs && node --test test/audit.test.mjs && node --test test/version-header.test.mjs && node --test test/audit-sqlite.test.mjs && node --test test/networks.test.mjs && node --test test/audit-shared.test.mjs && node --test test/audit-remote.test.mjs && node --test test/audit-tamper.test.mjs && node --test test/audit-verify.test.mjs && node --test test/fuzz.test.mjs && node --test test/property.test.mjs && node --test test/security-161.test.mjs && node --test test/docs-check.test.mjs && node scripts/docs-check.mjs",
    "test:integration": "node test/integration.mjs",
    "e2e:mock": "node scripts/e2e-mock.mjs",
    "smoke:sepolia": "node scripts/sepolia-smoke.mjs",
    "e2e:sepolia": "node scripts/e2e-sepolia.mjs",
    "demo:p2": "node scripts/p2-shared-demo.mjs",
    "demo:p3": "node scripts/p3-demo.mjs",
    "crash:1000": "node scripts/crash-1000.mjs",
    "e2e:battle": "node --max-http-header-size=65536 scripts/e2e-battle.mjs",
    "probe:402xagent-v1": "node --max-http-header-size=65536 scripts/probe-402xagent-v1.mjs",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "keywords": [
    "402xagent",
    "agents",
    "base",
    "guard",
    "mcp",
    "onBeforePaymentCreation",
    "payments",
    "pre-payment-check",
    "router",
    "solana",
    "usdc",
    "x402"
  ],
  "author": "withgrokbot",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withgrokbot/x402-spotcheck.git"
  },
  "homepage": "https://github.com/withgrokbot/x402-spotcheck#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@x402/axios": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/fetch": "^2.28.0",
    "axios": "^1.7.0",
    "fast-check": "^3.23.2",
    "viem": "^2.21.0"
  },
  "peerDependencies": {
    "@x402/core": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@x402/core": {
      "optional": true
    }
  }
}
